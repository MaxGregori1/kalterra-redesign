---
import Layout from '../layouts/Layout.astro'
const base = import.meta.env.BASE_URL
---

<Layout title="Home">
  <!-- ============================================
       HERO — Full-width video background
       ============================================ -->
  <section class="relative h-screen min-h-[700px] flex items-center justify-center overflow-hidden">
    <video
      autoplay
      muted
      loop
      playsinline
      class="absolute inset-0 w-full h-full object-cover"
    >
      <source src={`${base}assets/video/hero-video.mp4`} type="video/mp4" />
    </video>
    <div class="hero-overlay absolute inset-0"></div>
    <div class="relative z-10 text-center max-w-5xl mx-auto px-6">
      <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold text-white leading-tight animate-fade-up">
        Texas Multifamily.<br />
        Local Execution.<br />
        Durable Returns.
      </h1>
      <p class="mt-8 text-xl md:text-2xl lg:text-3xl font-light text-white/90 tracking-wide animate-fade-up delay-200">
        Acquire. Operate. Grow.
      </p>
      <div class="mt-12 flex flex-col sm:flex-row items-center justify-center gap-4 animate-fade-up delay-300">
        <a
          href={`${base}portfolio/`}
          class="px-8 py-4 bg-gold text-black font-semibold text-sm uppercase tracking-widest hover:bg-gold-light transition-colors"
        >
          View Portfolio
        </a>
        <a
          href={`${base}contact/`}
          class="px-8 py-4 border border-white/30 text-white font-semibold text-sm uppercase tracking-widest hover:bg-white/10 transition-colors"
        >
          Contact Us
        </a>
      </div>
    </div>
    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
      <svg class="w-6 h-6 text-white/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </div>
  </section>

  <!-- ============================================
       METRICS BAR
       ============================================ -->
  <section class="bg-gray-50 border-y border-gray-200">
    <div class="max-w-[1440px] mx-auto px-6 lg:px-12 py-16 lg:py-20">
      <p class="mb-12 text-center text-xl md:text-2xl text-gray-900 font-light">
        Over <span class="text-gold font-semibold">$475MM</span> in investments capitalized to date.
      </p>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12 text-center">
        <div>
          <p class="text-4xl md:text-5xl lg:text-6xl font-bold text-gold" data-counter="1,254">1,254</p>
          <p class="mt-3 text-sm md:text-base uppercase tracking-widest text-gray-500">Units Under Management</p>
        </div>
        <div>
          <p class="text-4xl md:text-5xl lg:text-6xl font-bold text-gold" data-counter="$110M">$110M</p>
          <p class="mt-3 text-sm md:text-base uppercase tracking-widest text-gray-500">Equity Under Management</p>
        </div>
        <div>
          <p class="text-4xl md:text-5xl lg:text-6xl font-bold text-gold" data-counter="23.5%">23.5%</p>
          <p class="mt-3 text-sm md:text-base uppercase tracking-widest text-gray-500">Historic Returns (Equity Weighted)</p>
        </div>
        <div>
          <p class="text-4xl md:text-5xl lg:text-6xl font-bold text-gold" data-counter="2.3x">2.3x</p>
          <p class="mt-3 text-sm md:text-base uppercase tracking-widest text-gray-500">Historic Equity Multiple (Equity Weighted)</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================
       FEATURED PROJECTS — Alpine Start grid style
       ============================================ -->
  <section class="bg-white py-20 lg:py-28">
    <div class="max-w-[1440px] mx-auto px-6 lg:px-12">
      <div class="flex flex-col md:flex-row items-start md:items-center justify-between mb-12 lg:mb-16">
        <h2 class="text-gray-900">Featured Investments</h2>
        <a href={`${base}portfolio/`} class="mt-4 md:mt-0 text-gold text-sm uppercase tracking-widest font-medium hover:text-gold-light inline-flex items-center gap-2">
          View All Investments
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Featured: Kinstead (Acquisition) -->
        <a href={`${base}portfolio/kinstead/`} class="project-card group relative aspect-[16/10] overflow-hidden col-span-1 md:col-span-2">
          <img src={`${base}assets/images/portfolio/kinstead.jpeg`} alt="Kinstead McKinney" class="w-full h-full object-cover" />
          <div class="project-overlay absolute inset-0 bg-black/60 flex flex-col justify-end p-8 lg:p-12">
            <p class="text-xs uppercase tracking-widest text-gold mb-1">McKinney, TX &middot; 376 Units</p>
            <h3 class="text-white text-3xl lg:text-4xl font-bold">Kinstead</h3>
          </div>
        </a>
        <!-- Arden at Kohlers Crossing -->
        <a href={`${base}portfolio/arden-at-kohlers-crossing/`} class="project-card group relative aspect-[16/10] overflow-hidden">
          <img src={`${base}assets/images/portfolio/arden-kohlers-featured.webp`} alt="Arden by Kalterra at Kohlers Crossing" class="w-full h-full object-cover" />
          <div class="project-overlay absolute inset-0 bg-black/60 flex flex-col justify-end p-8">
            <p class="text-xs uppercase tracking-widest text-gold mb-1">Kyle, TX &middot; 263 Units</p>
            <h3 class="text-white text-2xl lg:text-3xl font-bold">Arden at Kohlers Crossing</h3>
          </div>
        </a>
        <!-- Midtown GP -->
        <a href={`${base}portfolio/midtown-gp/`} class="project-card group relative aspect-[16/10] overflow-hidden">
          <img src={`${base}assets/images/portfolio/midtown-gp/01.jpg`} alt="Midtown GP" class="w-full h-full object-cover" />
          <div class="project-overlay absolute inset-0 bg-black/60 flex flex-col justify-end p-8">
            <p class="text-xs uppercase tracking-widest text-gold mb-1">Grand Prairie, TX &middot; 366 Units</p>
            <h3 class="text-white text-2xl lg:text-3xl font-bold">Arden at Midtown GP</h3>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- ============================================
       INVEST WITH KALTERRA
       ============================================ -->
  <!-- PLACEHOLDER — client to provide final copy -->
  <section class="bg-gray-50 py-20 lg:py-28">
    <div class="max-w-[1440px] mx-auto px-6 lg:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <div>
          <p class="text-sm uppercase tracking-widest text-gold mb-4">Invest With Kalterra</p>
          <h2 class="text-gray-900 mb-8">Partner With a Proven Texas Multifamily Operator</h2>
          <div class="space-y-6 text-gray-600 text-lg leading-relaxed">
            <p>
              Kalterra Capital Partners offers qualified investors access to institutional-quality
              multifamily investments in Texas's highest-growth submarkets. With deep local expertise
              and a hands-on operating philosophy, we deliver disciplined execution and transparent
              partnership from acquisition through disposition.
            </p>
            <p>
              Our investment strategy targets value-add and stabilized multifamily assets across
              the Dallas&ndash;Fort Worth metroplex, Austin, and San Antonio corridors. Every deal is
              underwritten with conservative assumptions, local market intelligence, and a commitment
              to creating long-term value for our limited partners.
            </p>
            <p>
              Whether you are an individual accredited investor or an institutional allocator,
              Kalterra provides the transparency, alignment, and operational rigor you expect
              from a best-in-class sponsor.
            </p>
          </div>
          <div class="mt-10 flex flex-col sm:flex-row gap-4">
            <a
              href={`${base}contact/`}
              class="px-8 py-4 bg-gold text-black font-semibold text-sm uppercase tracking-widest hover:bg-gold-light transition-colors text-center"
            >
              Get in Touch
            </a>
            <a
              href="https://investors.appfolioim.com/kalterracapital/investor/login"
              target="_blank"
              rel="noopener noreferrer"
              class="px-8 py-4 border border-gold text-gold font-semibold text-sm uppercase tracking-widest hover:bg-gold/10 transition-colors text-center"
            >
              Investor Login
            </a>
          </div>
        </div>
        <div class="relative aspect-[4/3] overflow-hidden">
          <img
            src={`${base}assets/images/about/property-twilight.webp`}
            alt="Kalterra property at twilight"
            class="w-full h-full object-cover"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================
       SELL OR RECAPITALIZE — Footer CTA
       ============================================ -->
  <!-- PLACEHOLDER — client to provide final copy -->
  <section class="relative bg-white py-20 lg:py-28 border-t border-gray-200">
    <div class="max-w-4xl mx-auto px-6 lg:px-12 text-center">
      <p class="text-sm uppercase tracking-widest text-gold mb-4">For Sellers &amp; Partners</p>
      <h2 class="text-gray-900 mb-8">Sell or Recapitalize Your Property</h2>
      <div class="space-y-6 text-gray-600 text-lg leading-relaxed max-w-3xl mx-auto">
        <p>
          Looking for a reliable buyer or recapitalization partner for your Texas multifamily asset?
          Kalterra Capital Partners brings the certainty and speed of a local sponsor with institutional
          capabilities.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-12">
        <div class="text-center">
          <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-gold/10 flex items-center justify-center">
            <svg class="w-8 h-8 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
          </div>
          <h4 class="text-gray-900 text-lg font-semibold mb-2">Local Sponsor</h4>
          <p class="text-gray-500 text-base">Dallas-based team with deep Texas market knowledge and on-the-ground operational expertise.</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-gold/10 flex items-center justify-center">
            <svg class="w-8 h-8 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" /></svg>
          </div>
          <h4 class="text-gray-900 text-lg font-semibold mb-2">Flexible Structures</h4>
          <p class="text-gray-500 text-base">Creative deal structures tailored to your objectives &mdash; from outright acquisitions to joint ventures and recapitalizations.</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-gold/10 flex items-center justify-center">
            <svg class="w-8 h-8 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
          </div>
          <h4 class="text-gray-900 text-lg font-semibold mb-2">Quick Closes</h4>
          <p class="text-gray-500 text-base">Proven ability to underwrite, capitalize, and close transactions efficiently with minimal friction.</p>
        </div>
      </div>
      <a
        href={`${base}contact/`}
        class="inline-block mt-12 px-8 py-4 bg-gold text-black font-semibold text-sm uppercase tracking-widest hover:bg-gold-light transition-colors"
      >
        Start a Conversation
      </a>
    </div>
  </section>
</Layout>
