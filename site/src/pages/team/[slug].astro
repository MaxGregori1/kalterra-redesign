---
import Layout from '../../layouts/Layout.astro'
import { Image } from 'astro:assets'
import { getTeam } from '../../data/team'
const base = import.meta.env.BASE_URL
const team = getTeam(base)

export function getStaticPaths() {
  const base = import.meta.env.BASE_URL
  const team = getTeam(base)
  return team.map((member) => ({
    params: { slug: member.slug },
    props: { member },
  }))
}

const { member } = Astro.props
---

<Layout title={member.name} description={`${member.name} — ${member.title} at Kalterra Capital Partners`} headerAlt={true}>
  <!-- HERO -->
  <section class="pt-32 pb-6 lg:pt-40 lg:pb-8 bg-white">
    <div class="max-w-[1440px] mx-auto px-6 lg:px-12">
      <a href={`${base}team/`} class="inline-flex items-center gap-2 text-sm text-gray-500 hover:text-gold transition-colors mb-8">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        Back to Our Team
      </a>
    </div>
  </section>

  <!-- PROFILE -->
  <section class="bg-white pb-20 lg:pb-28">
    <div class="max-w-[1440px] mx-auto px-6 lg:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 lg:gap-16">
        <!-- Photo -->
        <div class="lg:col-span-2">
          <!-- PLACEHOLDER — replace with updated headshot -->
          <div class="aspect-square overflow-hidden bg-gray-100">
            {typeof member.image === 'string' ? (
              <img
                src={member.image}
                alt={member.name}
                class="w-full h-full object-cover"
                style={member.imagePosition ? `object-position: ${member.imagePosition}` : undefined}
              />
            ) : (
              <Image
                src={member.image}
                alt={member.name}
                width={1060}
                quality={85}
                class="w-full h-full object-cover"
                style={member.imagePosition ? `object-position: ${member.imagePosition}` : undefined}
              />
            )}
          </div>
        </div>

        <!-- Bio content -->
        <div class="lg:col-span-3">
          <h1 class="text-gray-900 mb-2">{member.name}</h1>
          <p class="text-gold text-lg mb-10">{member.title}</p>

          {member.bio && (
            <p class="text-gray-600 text-lg leading-relaxed">{member.bio}</p>
          )}

          {member.education && member.education.length > 0 && (
            <div class="mt-10 pt-8 border-t border-gray-200">
              <h5 class="text-gray-900 font-semibold mb-4">Education</h5>
              <ul class="space-y-2">
                {member.education.map((edu: string) => (
                  <li class="text-gray-600">{edu}</li>
                ))}
              </ul>
            </div>
          )}

          {member.credentials && member.credentials.length > 0 && (
            <div class="mt-8">
              <h5 class="text-gray-900 font-semibold mb-4">Credentials</h5>
              <ul class="space-y-2">
                {member.credentials.map((cred: string) => (
                  <li class="text-gray-600">{cred}</li>
                ))}
              </ul>
            </div>
          )}

          {member.email && (
            <div class="mt-10 pt-8 border-t border-gray-200">
              <a href={`mailto:${member.email}`} class="text-gray-500 hover:text-gold transition-colors">{member.email}</a>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>
</Layout>
