---
import Layout from '../../layouts/Layout.astro'
import { Image } from 'astro:assets'
import { getTeam } from '../../data/team'
const base = import.meta.env.BASE_URL
const team = getTeam(base)
---

<Layout title="Team" headerAlt={true}>
  <!-- ============================================
       HERO
       ============================================ -->
  <section class="pt-32 pb-12 lg:pt-40 lg:pb-16 bg-white">
    <div class="max-w-[1440px] mx-auto px-6 lg:px-12">
      <p class="text-sm uppercase tracking-widest text-gold mb-4">Our Team</p>
      <h1 class="text-gray-900">Exceptional People.<br />Exceptional Returns.</h1>
    </div>
  </section>

  <!-- ============================================
       TEAM GRID
       ============================================ -->
  <section class="bg-white pb-20 lg:pb-28">
    <div class="max-w-[1440px] mx-auto px-6 lg:px-12">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-16">
        {team.map((member) => (
          <a href={`${base}team/${member.slug}/`} class="team-card group block">
            <!-- PLACEHOLDER — replace with updated headshot -->
            <div class="aspect-square overflow-hidden bg-gray-100 mb-6">
              {typeof member.image === 'string' ? (
                <img
                  src={member.image}
                  alt={member.name}
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
              ) : (
                <Image
                  src={member.image}
                  alt={member.name}
                  width={900}
                  quality={85}
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
              )}
            </div>
            <h4 class="text-gray-900 font-semibold">{member.name}</h4>
            <p class="text-gold text-base mt-1">{member.title}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-gray-50 py-20 lg:py-28 border-t border-gray-200">
    <div class="max-w-3xl mx-auto px-6 lg:px-12 text-center">
      <h2 class="text-gray-900 mb-6">Want to join our team?</h2>
      <a
        href={`${base}contact/`}
        class="inline-block px-10 py-4 bg-gold text-black font-semibold text-sm uppercase tracking-widest hover:bg-gold-light transition-colors"
      >
        Get in Touch
      </a>
    </div>
  </section>
</Layout>
