---
import Layout from '../layouts/Layout.astro'
---

<Layout title="Contact" headerAlt={true}>
  <!-- ============================================
       HERO
       ============================================ -->
  <section class="pt-32 pb-12 lg:pt-40 lg:pb-16 bg-black">
    <div class="max-w-[1440px] mx-auto px-6 lg:px-12 text-center">
      <p class="text-sm uppercase tracking-widest text-gold mb-4">Get in Touch</p>
      <h1 class="text-white mb-6">Contact Us</h1>
      <p class="text-gray-300 text-lg max-w-2xl mx-auto">
        We are always seeking investment opportunities and strategic partnerships.
        Message us to find out how we can work together.
      </p>
    </div>
  </section>

  <!-- ============================================
       CONTACT CONTENT
       ============================================ -->
  <section class="bg-black pb-20 lg:pb-28">
    <div class="max-w-[1440px] mx-auto px-6 lg:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-20">
        <!-- Contact Info -->
        <div>
          <h3 class="text-white mb-8">Where to Find Us</h3>
          <div class="space-y-8">
            <div>
              <h5 class="text-gold text-sm uppercase tracking-widest mb-3">Address</h5>
              <p class="text-gray-300 text-lg">
                1845 Woodall Rodgers Fwy<br />
                Ste 1160<br />
                Dallas, TX 75201
              </p>
            </div>
            <div>
              <h5 class="text-gold text-sm uppercase tracking-widest mb-3">Hours</h5>
              <p class="text-gray-300 text-lg">
                By appointment only<br />
                Monday &ndash; Friday
              </p>
            </div>
            <div>
              <h5 class="text-gold text-sm uppercase tracking-widest mb-3">Email</h5>
              <a href="mailto:info@kalterra.com" class="text-gray-300 text-lg hover:text-gold">
                info@kalterra.com
              </a>
            </div>
          </div>

          <!-- Map embed area -->
          <div class="mt-12 aspect-[4/3] bg-gray-900 flex items-center justify-center">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3353.!2d-96.8066!3d32.7912!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x864e9927c02c8b87%3A0x0!2s1845+Woodall+Rodgers+Fwy%2C+Dallas%2C+TX+75201!5e0!3m2!1sen!2sus!4v1"
              width="100%"
              height="100%"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Kalterra office location"
            ></iframe>
          </div>
        </div>

        <!-- Contact Form -->
        <div>
          <h3 class="text-white mb-8">Send Us a Message</h3>
          <form class="space-y-6" data-contact-form>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label for="firstName" class="block text-sm uppercase tracking-widest text-gray-400 mb-2">
                  First Name <span class="text-gold">*</span>
                </label>
                <input
                  type="text"
                  id="firstName"
                  name="firstName"
                  autocomplete="given-name"
                  required
                  class="w-full bg-transparent border border-gray-700 px-4 py-3 text-white text-lg focus:border-gold focus:outline-none transition-colors"
                />
              </div>
              <div>
                <label for="lastName" class="block text-sm uppercase tracking-widest text-gray-400 mb-2">
                  Last Name <span class="text-gold">*</span>
                </label>
                <input
                  type="text"
                  id="lastName"
                  name="lastName"
                  autocomplete="family-name"
                  required
                  class="w-full bg-transparent border border-gray-700 px-4 py-3 text-white text-lg focus:border-gold focus:outline-none transition-colors"
                />
              </div>
            </div>
            <div>
              <label for="email" class="block text-sm uppercase tracking-widest text-gray-400 mb-2">
                Email Address <span class="text-gold">*</span>
              </label>
              <input
                type="email"
                id="email"
                name="email"
                autocomplete="email"
                spellcheck="false"
                required
                class="w-full bg-transparent border border-gray-700 px-4 py-3 text-white text-lg focus:border-gold focus:outline-none transition-colors"
              />
            </div>
            <div>
              <label for="phone" class="block text-sm uppercase tracking-widest text-gray-400 mb-2">
                Phone Number
              </label>
              <input
                type="tel"
                id="phone"
                name="phone"
                autocomplete="tel"
                class="w-full bg-transparent border border-gray-700 px-4 py-3 text-white text-lg focus:border-gold focus:outline-none transition-colors"
              />
            </div>
            <div>
              <label for="inquiry" class="block text-sm uppercase tracking-widest text-gray-400 mb-2">
                Inquiry Type
              </label>
              <select
                id="inquiry"
                name="inquiry"
                class="w-full bg-transparent border border-gray-700 px-4 py-3 text-white text-lg focus:border-gold focus:outline-none transition-colors"
              >
                <option value="general" class="bg-gray-900">General Inquiry</option>
                <option value="investment" class="bg-gray-900">Investment Opportunity</option>
                <option value="seller" class="bg-gray-900">Sell or Recapitalize</option>
                <option value="press" class="bg-gray-900">Press / Media</option>
              </select>
            </div>
            <div>
              <label for="message" class="block text-sm uppercase tracking-widest text-gray-400 mb-2">
                Message <span class="text-gold">*</span>
              </label>
              <textarea
                id="message"
                name="message"
                rows="6"
                required
                class="w-full bg-transparent border border-gray-700 px-4 py-3 text-white text-lg focus:border-gold focus:outline-none transition-colors resize-none"
              ></textarea>
            </div>
            <button
              type="submit"
              class="w-full px-8 py-4 bg-gold text-black font-semibold text-sm uppercase tracking-widest hover:bg-gold-light transition-colors"
            >
              Send Message
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>
</Layout>
