---
import Layout from '../layouts/Layout.astro'
const base = import.meta.env.BASE_URL

const news = [
  {
    title: 'Turner Impact Capital and Kalterra Capital Partners Acquire 376-Unit Kinstead Apartment Community in Dallas-Fort Worth Submarket',
    date: 'July 25, 2025',
    source: 'MultifamilyBiz',
    image: `${base}assets/images/portfolio/kinstead.jpeg`,
    url: 'https://www.multifamilybiz.com/news/11173/turner_impact_capital_and_kalterra_capital_partner',
    featured: true,
  },
  {
    title: 'Kalterra Team Members and the Future of Multifamily Developments in Texas',
    date: 'February 9, 2022',
    source: 'BISNOW',
    image: `${base}assets/images/newsroom/bisnow-texas.jpg`,
    url: 'https://kalterra.com/kalterra-team-members-and-the-future-of-multifamily-developments-in-texas/',
  },
  {
    title: 'This Dallas Real Estate Firm is Betting on Horizontal Communities, Transparency and Themselves',
    date: 'November 29, 2021',
    source: 'Dallas Business Journal',
    image: `${base}assets/images/newsroom/grand-prairie-night.jpg`,
    url: 'https://kalterra.com/this-dallas-real-estate-firm-is-betting-on-horizontal-communities-transparency-and-themselves/',
  },
  {
    title: 'Kalterra Capital Partners Breaks Ground on Multifamily Development in Waxahachie',
    date: 'November 16, 2021',
    source: 'Waxahachie Sun',
    image: `${base}assets/images/newsroom/hamilton-garden-valley.jpg`,
    url: 'https://kalterra.com/kalterra-capital-partners-breaks-ground-on-multifamily-development-in-waxahachie/',
  },
  {
    title: 'Grand Prairie Development Will Bring Housing and Retail',
    date: 'October 27, 2021',
    source: 'Dallas Morning News',
    image: `${base}assets/images/newsroom/grand-prairie-aerial.jpg`,
    url: 'https://kalterra.com/grand-prairie-development-will-bring-housing-and-retail/',
  },
  {
    title: 'Texas Apartment Developer Gets Ready to Build More Projects in the Lone Star State',
    date: 'May 26, 2021',
    source: 'CoStar',
    image: `${base}assets/images/newsroom/fitzgerald.jpg`,
    url: 'https://kalterra.com/texas-apartment-developer-gets-ready-to-build-more-projects-in-the-lone-star-state/',
  },
  {
    title: 'Dallas Firm Sells Luxury Apartment Complex in Waxahachie',
    date: 'May 4, 2021',
    source: 'Ft. Worth Inc.',
    image: `${base}assets/images/newsroom/waxahachie-sale.webp`,
    url: 'https://kalterra.com/dallas-firm-sells-luxury-apartment-complex-in-waxahachie/',
  },
  {
    title: 'Kalterra Capital Partners Announces Sale of McCarty Commons',
    date: 'April 7, 2021',
    source: 'San Marcos Daily Record',
    image: `${base}assets/images/newsroom/mccarty-commons-sale.webp`,
    url: 'https://kalterra.com/kalterra-capital-partners-announces-sale-of-mccarty-commons/',
  },
  {
    title: 'City of Kyle Approves Development & Zoning Near Kohler\'s Crossing',
    date: 'August 19, 2020',
    source: 'Hays Free Press',
    image: `${base}assets/images/newsroom/kohlers-crossing.webp`,
    url: 'https://kalterra.com/city-of-kyle-approves-development-zoning-near-kohlers-crossing/',
  },
  {
    title: 'Meet Kalterra Court',
    date: 'November 19, 2019',
    source: 'Voyage Dallas',
    image: `${base}assets/images/newsroom/kalterra-court.jpg`,
    url: 'https://kalterra.com/meet-kalterra-court/',
  },
  {
    title: 'Kalterra Capital Lands $26M Construction Loan',
    date: 'May 4, 2018',
    source: 'Multi-Housing News',
    image: '/assets/images/newsroom/park-place-clubhouse.jpg',
    url: 'https://kalterra.com/kalterra-capital-lands-26m-construction-loan/',
  },
]

const featured = news.find(n => n.featured)
const rest = news.filter(n => !n.featured)
---

<Layout title="Newsroom" headerAlt={true}>
  <!-- ============================================
       HERO
       ============================================ -->
  <section class="pt-32 pb-12 lg:pt-40 lg:pb-16 bg-black">
    <div class="max-w-[1440px] mx-auto px-6 lg:px-12">
      <p class="text-sm uppercase tracking-widest text-gold mb-4">Newsroom</p>
      <h1 class="text-white">In the Press</h1>
    </div>
  </section>

  <!-- ============================================
       FEATURED ARTICLE
       ============================================ -->
  {featured && (
    <section class="bg-black pb-16 lg:pb-20">
      <div class="max-w-[1440px] mx-auto px-6 lg:px-12">
        <a
          href={featured.url}
          target="_blank"
          rel="noopener noreferrer"
          class="project-card group grid grid-cols-1 lg:grid-cols-2 gap-0 overflow-hidden bg-gray-950"
        >
          <div class="aspect-[16/10] lg:aspect-auto overflow-hidden">
            <img src={featured.image} alt={featured.title} class="w-full h-full object-cover" />
          </div>
          <div class="p-8 lg:p-12 flex flex-col justify-center">
            <div class="flex items-center gap-4 mb-4">
              <span class="text-xs uppercase tracking-widest text-gold font-medium">{featured.source}</span>
              <span class="text-gray-600">&middot;</span>
              <span class="text-gray-400 text-sm">{featured.date}</span>
            </div>
            <h3 class="text-white font-bold text-2xl lg:text-3xl leading-tight group-hover:text-gold transition-colors">
              {featured.title}
            </h3>
            <span class="mt-6 text-gold text-sm uppercase tracking-widest font-medium inline-flex items-center gap-2">
              Read Article
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
            </span>
          </div>
        </a>
      </div>
    </section>
  )}

  <!-- ============================================
       ALL ARTICLES
       ============================================ -->
  <section class="bg-black pb-20 lg:pb-28">
    <div class="max-w-[1440px] mx-auto px-6 lg:px-12">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {rest.map((article) => (
          <a
            href={article.url}
            target="_blank"
            rel="noopener noreferrer"
            class="project-card group"
          >
            <div class="aspect-[16/10] overflow-hidden mb-6">
              <img src={article.image} alt={article.title} class="w-full h-full object-cover" />
            </div>
            <div class="flex items-center gap-4 mb-3">
              <span class="text-xs uppercase tracking-widest text-gold font-medium">{article.source}</span>
              <span class="text-gray-600">&middot;</span>
              <span class="text-gray-400 text-sm">{article.date}</span>
            </div>
            <h4 class="text-white font-semibold text-lg leading-snug group-hover:text-gold transition-colors">
              {article.title}
            </h4>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-gray-950 py-20 lg:py-28 border-t border-gray-800">
    <div class="max-w-3xl mx-auto px-6 lg:px-12 text-center">
      <h2 class="text-white mb-6">Want to know more?</h2>
      <a
        href={`${base}contact/`}
        class="inline-block px-10 py-4 bg-gold text-black font-semibold text-sm uppercase tracking-widest hover:bg-gold-light transition-colors"
      >
        Contact Us
      </a>
    </div>
  </section>
</Layout>
