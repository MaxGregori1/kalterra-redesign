---

<Layout title="Portfolio" headerAlt={true}>
  <!-- ============================================
       HERO
       ============================================ -->
  <section class="pt-32 pb-12 lg:pt-40 lg:pb-16 bg-black">
    <div class="max-w-[1440px] mx-auto px-6 lg:px-12">
      <p class="text-sm uppercase tracking-widest text-gold mb-4">Our Portfolio</p>
      <h1 class="text-white">Projects</h1>
    </div>
  </section>

  <!-- ============================================
       FILTER NAV
       ============================================ -->
  <section class="bg-black pb-8">
    <div class="max-w-[1440px] mx-auto px-6 lg:px-12">
      <nav class="flex flex-wrap gap-4 lg:gap-8 border-b border-gray-800 pb-6">
        <a href="#acquisitions" class="text-sm uppercase tracking-widest text-gold font-medium hover:text-gold-light">Acquisitions</a>
        <a href="#developments" class="text-sm uppercase tracking-widest text-gray-400 font-medium hover:text-white">Development</a>
        <a href="#vala" class="text-sm uppercase tracking-widest text-gray-400 font-medium hover:text-white">VALA</a>
        <a href="#retail" class="text-sm uppercase tracking-widest text-gray-400 font-medium hover:text-white">Retail</a>
      </nav>
    </div>
  </section>

  <!-- ============================================
       ACQUISITIONS
       ============================================ -->
  <section id="acquisitions" class="bg-black pb-20 lg:pb-28">
    <div class="max-w-[1440px] mx-auto px-6 lg:px-12">
      <h2 class="text-white mb-10">Acquisitions</h2>

      <!-- Kinstead Featured -->
      <a href={`${base}portfolio/${acquisitions[0].slug}/`} class="block mb-16" id="kinstead">
        <div class="project-card relative aspect-[21/9] overflow-hidden mb-8">
          <img src={acquisitions[0].image} alt={acquisitions[0].name} class="w-full h-full object-cover" />
          <div class="project-overlay absolute inset-0 bg-black/60 flex flex-col justify-end p-8 lg:p-12">
            <p class="text-sm uppercase tracking-widest text-gold mb-2">{acquisitions[0].type} &middot; {acquisitions[0].location}</p>
            <h3 class="text-white text-3xl lg:text-4xl font-bold">{acquisitions[0].name}</h3>
            <ul class="mt-4 flex flex-wrap gap-6 text-gray-300 text-sm">
              <li>{acquisitions[0].units}</li>
              <li>{acquisitions[0].built}</li>
            </ul>
          </div>
        </div>
        <p class="text-gray-300 text-lg leading-relaxed max-w-4xl">
          {acquisitions[0].description}
        </p>
      </a>

      <!-- Other Acquisitions -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {acquisitions.slice(1).map((project) => (
          <a href={`${base}portfolio/${project.slug}/`} id={project.id} class="project-card group relative aspect-[4/3] overflow-hidden">
            <img src={project.image} alt={project.name} class="w-full h-full object-cover" />
            <div class="project-overlay absolute inset-0 bg-black/60 flex flex-col justify-end p-6">
              <p class="text-xs uppercase tracking-widest text-gold mb-1">{project.type} &middot; {project.location}</p>
              <h4 class="text-white font-bold text-xl">{project.name}</h4>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================
       DEVELOPMENTS
       ============================================ -->
  <section id="developments" class="bg-gray-950 py-20 lg:py-28">
    <div class="max-w-[1440px] mx-auto px-6 lg:px-12">
      <h2 class="text-white mb-10">Development</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {developments.map((project) => (
          <a href={`${base}portfolio/${project.slug}/`} id={project.id} class="project-card group relative aspect-[4/3] overflow-hidden">
            <img src={project.image} alt={project.name} class="w-full h-full object-cover" />
            <div class="project-overlay absolute inset-0 bg-black/60 flex flex-col justify-end p-6">
              <p class="text-xs uppercase tracking-widest text-gold mb-1">{project.type} &middot; {project.location}</p>
              <h4 class="text-white font-bold text-xl">{project.name}</h4>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================
       VALA
       ============================================ -->
  <section id="vala" class="bg-black py-20 lg:py-28">
    <div class="max-w-[1440px] mx-auto px-6 lg:px-12">
      <h2 class="text-white mb-4">VALA</h2>
      <p class="text-gray-400 text-lg mb-10">Kalterra's multifamily development brand</p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
        {vala.map((project) => (
          <a href={`${base}portfolio/${project.slug}/`} id={project.id} class="project-card group relative aspect-[4/3] overflow-hidden">
            <img src={project.image} alt={project.name} class="w-full h-full object-cover" />
            <div class="project-overlay absolute inset-0 bg-black/60 flex flex-col justify-end p-6">
              <p class="text-xs uppercase tracking-widest text-gold mb-1">{project.type} &middot; {project.location}</p>
              <h4 class="text-white font-bold text-xl">{project.name}</h4>
            </div>
          </a>
        ))}
      </div>

      <!-- Upcoming VALA developments -->
      <div>
        <h3 class="text-white mb-6">Upcoming Developments</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {valaUpcoming.map((project) => (
            <div class="border border-gray-800 p-8 text-center">
              <p class="text-sm uppercase tracking-widest text-gold mb-2">Coming Soon</p>
              <h4 class="text-white font-bold text-xl">{project.name}</h4>
              <p class="text-gray-400 mt-2">{project.location}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================
       RETAIL
       ============================================ -->
  <section id="retail" class="bg-gray-950 py-20 lg:py-28">
    <div class="max-w-[1440px] mx-auto px-6 lg:px-12">
      <h2 class="text-white mb-10">Retail</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {retail.map((project) => (
          <a href={`${base}portfolio/${project.slug}/`} id={project.id} class="project-card group relative aspect-[4/3] overflow-hidden">
            <img src={project.image} alt={project.name} class="w-full h-full object-cover" />
            <div class="project-overlay absolute inset-0 bg-black/60 flex flex-col justify-end p-6">
              <p class="text-xs uppercase tracking-widest text-gold mb-1">{project.type} &middot; {project.location}</p>
              <h4 class="text-white font-bold text-xl">{project.name}</h4>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-black py-20 lg:py-28 border-t border-gray-800">
    <div class="max-w-3xl mx-auto px-6 lg:px-12 text-center">
      <h2 class="text-white mb-6">Interested in our portfolio?</h2>
      <a
        href={`${base}contact/`}
        class="inline-block px-10 py-4 bg-gold text-black font-semibold text-sm uppercase tracking-widest hover:bg-gold-light transition-colors"
      >
        Contact Us
      </a>
    </div>
  </section>
</Layout>
