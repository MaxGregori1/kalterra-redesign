---

<Layout title="Portfolio" headerAlt={true}>
  <!-- ============================================
       HERO
       ============================================ -->
  <section class="pt-32 pb-12 lg:pt-40 lg:pb-16 bg-white">
    <div class="max-w-[1440px] mx-auto px-6 lg:px-12">
      <p class="text-sm uppercase tracking-widest text-gold mb-4">Our Portfolio</p>
      <h1 class="text-gray-900">Investments</h1>
    </div>
  </section>

  <!-- ============================================
       FILTER NAV
       ============================================ -->
  <section class="bg-white pb-8">
    <div class="max-w-[1440px] mx-auto px-6 lg:px-12">
      <nav class="flex flex-wrap gap-4 lg:gap-8 border-b border-gray-200 pb-6">
        <a href="#operating-assets" class="text-sm uppercase tracking-widest text-gold font-medium hover:text-gold-light">Operating Assets</a>
        <a href="#exited-projects" class="text-sm uppercase tracking-widest text-gray-500 font-medium hover:text-gray-900">Exited Investments</a>
        <a href="#future-projects" class="text-sm uppercase tracking-widest text-gray-500 font-medium hover:text-gray-900">Future Projects</a>
      </nav>
    </div>
  </section>

  <!-- ============================================
       OPERATING ASSETS
       ============================================ -->
  <section id="operating-assets" class="bg-white pb-20 lg:pb-28">
    <div class="max-w-[1440px] mx-auto px-6 lg:px-12">
      <h2 class="text-gray-900 mb-10">Operating Assets</h2>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {activeProjects.map((project) => (
          <a href={`${base}portfolio/${project.slug}/`} id={project.id} class="project-card group relative aspect-[4/3] overflow-hidden">
            <img src={project.image} alt={project.name} class="w-full h-full object-cover" />
            <div class="project-overlay absolute inset-0 bg-black/60 flex flex-col justify-end p-6">
              <p class="text-xs uppercase tracking-widest text-gold mb-1">{project.location}{project.units ? ` · ${project.units} Units` : ''}</p>
              <h4 class="text-white font-bold text-xl">{project.name}</h4>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================
       EXITED PROJECTS
       ============================================ -->
  <section id="exited-projects" class="bg-gray-50 py-20 lg:py-28">
    <div class="max-w-[1440px] mx-auto px-6 lg:px-12">
      <h2 class="text-gray-900 mb-12">Exited Investments</h2>

      <!-- Returns -->
      <div class="border border-gray-200 px-6 pt-12 pb-6 lg:px-12 lg:pt-16 lg:pb-8 mb-16">
        <div class="grid grid-cols-2 lg:grid-cols-5 gap-8 lg:gap-8 text-center">
          <div>
            <p class="text-3xl md:text-4xl lg:text-5xl font-bold text-gold">00.0%</p>
            <p class="mt-3 text-xs md:text-sm uppercase tracking-widest text-gray-500">Average IRR</p>
          </div>
          <div>
            <p class="text-3xl md:text-4xl lg:text-5xl font-bold text-gold">0.00x</p>
            <p class="mt-3 text-xs md:text-sm uppercase tracking-widest text-gray-500">Average Equity Multiple</p>
          </div>
          <div>
            <p class="text-3xl md:text-4xl lg:text-5xl font-bold text-gold">0</p>
            <p class="mt-3 text-xs md:text-sm uppercase tracking-widest text-gray-500">Total Investments Realized</p>
          </div>
          <div>
            <p class="text-3xl md:text-4xl lg:text-5xl font-bold text-gold">$0M</p>
            <p class="mt-3 text-xs md:text-sm uppercase tracking-widest text-gray-500">Total Capital Invested</p>
          </div>
          <div class="col-span-2 lg:col-span-1">
            <p class="text-3xl md:text-4xl lg:text-5xl font-bold text-gold">$0M</p>
            <p class="mt-3 text-xs md:text-sm uppercase tracking-widest text-gray-500">Total Capital Returned</p>
          </div>
        </div>
        <p class="mt-6 text-center text-sm text-gray-400 italic">Performance reflects the results of all realized investments</p>
      </div>

      <!-- Multifamily subsection -->
      <h3 class="text-gray-900 text-xl font-semibold mb-8">Multifamily</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
        {exitedMultifamily.map((project) => (
          <a href={`${base}portfolio/${project.slug}/`} id={project.id} class="project-card group relative aspect-[4/3] overflow-hidden">
            <img src={project.image} alt={project.name} class="w-full h-full object-cover" />
            <div class="project-overlay absolute inset-0 bg-black/60 flex flex-col justify-end p-6">
              <p class="text-xs uppercase tracking-widest text-gold mb-1">{project.location}{project.units ? ` · ${project.units} Units` : ''}</p>
              <h4 class="text-white font-bold text-xl">{project.name}</h4>
            </div>
          </a>
        ))}
      </div>

      <!-- Retail subsection -->
      <h3 class="text-gray-900 text-xl font-semibold mb-8">Retail</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
        {exitedRetail.map((project) => (
          <a href={`${base}portfolio/${project.slug}/`} id={project.id} class="project-card group relative aspect-[4/3] overflow-hidden">
            <img src={project.image} alt={project.name} class="w-full h-full object-cover" />
            <div class="project-overlay absolute inset-0 bg-black/60 flex flex-col justify-end p-6">
              <p class="text-xs uppercase tracking-widest text-gold mb-1">{project.location}</p>
              <h4 class="text-white font-bold text-xl">{project.name}</h4>
            </div>
          </a>
        ))}
      </div>

      <!-- Single-Family subsection -->
      <h3 class="text-gray-900 text-xl font-semibold mb-8">Single-Family</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {exitedSingleFamily.map((project) => (
          <a href={`${base}portfolio/${project.slug}/`} id={project.id} class="project-card group relative aspect-[4/3] overflow-hidden">
            <img src={project.image} alt={project.name} class="w-full h-full object-cover" />
            <div class="project-overlay absolute inset-0 bg-black/60 flex flex-col justify-end p-6">
              <p class="text-xs uppercase tracking-widest text-gold mb-1">{project.location}</p>
              <h4 class="text-white font-bold text-xl">{project.name}</h4>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================
       FUTURE PROJECTS
       ============================================ -->
  <section id="future-projects" class="bg-white py-20 lg:py-28">
    <div class="max-w-[1440px] mx-auto px-6 lg:px-12">
