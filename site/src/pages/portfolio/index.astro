---

<Layout title="Portfolio" headerAlt={true}>
  <!-- ============================================
       HERO
       ============================================ -->
  <section class="pt-32 pb-12 lg:pt-40 lg:pb-16 bg-white">
    <div class="max-w-[1440px] mx-auto px-6 lg:px-12">
      <p class="text-sm uppercase tracking-widest text-gold mb-4">Our Portfolio</p>
      <h1 class="text-gray-900">Projects</h1>
    </div>
  </section>

  <!-- ============================================
       FILTER NAV
       ============================================ -->
  <section class="bg-white pb-8">
    <div class="max-w-[1440px] mx-auto px-6 lg:px-12">
      <nav class="flex flex-wrap gap-4 lg:gap-8 border-b border-gray-200 pb-6">
        <a href="#active-projects" class="text-sm uppercase tracking-widest text-gold font-medium hover:text-gold-light">Active Projects</a>
        <a href="#exited-projects" class="text-sm uppercase tracking-widest text-gray-500 font-medium hover:text-gray-900">Exited Projects</a>
        <a href="#future-projects" class="text-sm uppercase tracking-widest text-gray-500 font-medium hover:text-gray-900">Future Projects</a>
      </nav>
    </div>
  </section>

  <!-- ============================================
       ACTIVE PROJECTS
       ============================================ -->
  <section id="active-projects" class="bg-white pb-20 lg:pb-28">
    <div class="max-w-[1440px] mx-auto px-6 lg:px-12">
      <h2 class="text-gray-900 mb-10">Active Projects</h2>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {activeProjects.map((project) => (
          <a href={`${base}portfolio/${project.slug}/`} id={project.id} class="project-card group relative aspect-[4/3] overflow-hidden">
            <img src={project.image} alt={project.name} class="w-full h-full object-cover" />
            <div class="project-overlay absolute inset-0 bg-black/60 flex flex-col justify-end p-6">
              <p class="text-xs uppercase tracking-widest text-gold mb-1">{project.type} &middot; {project.location}</p>
              <h4 class="text-white font-bold text-xl">{project.name}</h4>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================
       EXITED PROJECTS
       ============================================ -->
  <section id="exited-projects" class="bg-gray-50 py-20 lg:py-28">
    <div class="max-w-[1440px] mx-auto px-6 lg:px-12">
      <h2 class="text-gray-900 mb-12">Exited Projects</h2>

      <!-- Development subsection -->
      <h3 class="text-gray-900 text-xl font-semibold mb-8">Development</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
        {exitedDevelopment.map((project) => (
          <a href={`${base}portfolio/${project.slug}/`} id={project.id} class="project-card group relative aspect-[4/3] overflow-hidden">
            <img src={project.image} alt={project.name} class="w-full h-full object-cover" />
            <div class="project-overlay absolute inset-0 bg-black/60 flex flex-col justify-end p-6">
              <p class="text-xs uppercase tracking-widest text-gold mb-1">{project.type} &middot; {project.location}</p>
              <h4 class="text-white font-bold text-xl">{project.name}</h4>
            </div>
          </a>
        ))}
      </div>

      <!-- Retail subsection -->
      <h3 class="text-gray-900 text-xl font-semibold mb-8">Retail</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
        {exitedRetail.map((project) => (
          <a href={`${base}portfolio/${project.slug}/`} id={project.id} class="project-card group relative aspect-[4/3] overflow-hidden">
            <img src={project.image} alt={project.name} class="w-full h-full object-cover" />
            <div class="project-overlay absolute inset-0 bg-black/60 flex flex-col justify-end p-6">
              <p class="text-xs uppercase tracking-widest text-gold mb-1">{project.type} &middot; {project.location}</p>
              <h4 class="text-white font-bold text-xl">{project.name}</h4>
            </div>
          </a>
        ))}
      </div>

      <!-- Land subsection -->
      <h3 class="text-gray-900 text-xl font-semibold mb-8">Land</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {exitedLand.map((project) => (
          <a href={`${base}portfolio/${project.slug}/`} id={project.id} class="project-card group relative aspect-[4/3] overflow-hidden">
            <img src={project.image} alt={project.name} class="w-full h-full object-cover" />
