        <h4 class="text-gray-900 font-bold text-xl">VALA Princeton</h4>
        <p class="text-gray-500 mt-2">Princeton, TX</p>
      </div>
      <div class="border border-gray-200 p-8 text-center">
        <p class="text-sm uppercase tracking-widest text-gold mb-2">Coming Soon</p>
