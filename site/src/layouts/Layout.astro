---
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'

interface Props {
  title: string
  description?: string
  headerAlt?: boolean
}

const { title, description = 'Kalterra Capital Partners — Texas Multifamily Acquisitions. Local Execution. Durable Returns.', headerAlt = false } = Astro.props
const base = import.meta.env.BASE_URL
---

<!DOCTYPE html>
<html lang="en" style="color-scheme: light;">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#ffffff" />
  <title>{title} | Kalterra</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/webp" href={`${base}assets/images/logos/favicon-32.webp`} />
  <link rel="apple-touch-icon" href={`${base}assets/images/logos/favicon-180.webp`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
</head>
<body>
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-gold focus:text-black focus:font-semibold">Skip to content</a>
  <Header alt={headerAlt} />
  <main id="main-content">
    <slot />
  </main>
  <Footer />

  <script>
    // Header scroll behavior
    const header = document.querySelector('[data-header]') as HTMLElement | null
    if (header) {
      const isAlt = header.dataset.headerAlt === 'true'
      const logo = header.querySelector('[data-logo]') as HTMLImageElement | null
      const logoBlack = logo?.dataset.logoBlack || ''
      const logoWhite = logo?.dataset.logoWhite || ''
      const navLinks = header.querySelectorAll('nav a:not([target="_blank"])')
      const hamburgerBars = header.querySelectorAll('[data-menu-toggle] span')

      if (!isAlt) {
        // Home page: transition from transparent (white text) to solid white (dark text) on scroll
        window.addEventListener('scroll', () => {
          if (window.scrollY > 50) {
            header.classList.add('bg-white/95', 'backdrop-blur-md', 'shadow-sm')
            header.classList.remove('bg-transparent')
            if (logo) logo.src = logoBlack
            navLinks.forEach(a => {
              if (!a.classList.contains('text-gold')) {
                a.classList.remove('text-white')
                a.classList.add('text-gray-800')
              }
            })
            hamburgerBars.forEach(s => {
              s.classList.remove('bg-white')
              s.classList.add('bg-gray-800')
            })
          } else {
            header.classList.remove('bg-white/95', 'backdrop-blur-md', 'shadow-sm')
            header.classList.add('bg-transparent')
            if (logo) logo.src = logoWhite
            navLinks.forEach(a => {
              if (!a.classList.contains('text-gold')) {
                a.classList.remove('text-gray-800')
                a.classList.add('text-white')
              }
            })
            hamburgerBars.forEach(s => {
              s.classList.remove('bg-gray-800')
              s.classList.add('bg-white')
            })
          }
        })
      }
    }

    // Mobile menu toggle
    const menuBtn = document.querySelector('[data-menu-toggle]')
    const mobileMenu = document.querySelector('[data-mobile-menu]')
    const body = document.body
    if (menuBtn && mobileMenu) {
      const hamburgerBarsAll = menuBtn.querySelectorAll('span')
      menuBtn.addEventListener('click', () => {
        body.classList.toggle('nav-open')
        const isOpen = body.classList.contains('nav-open')
        menuBtn.setAttribute('aria-expanded', isOpen.toString())
        // Force dark hamburger bars when menu is open (white bg)
        hamburgerBarsAll.forEach(s => {
          if (isOpen) {
            s.classList.remove('bg-white')
            s.classList.add('bg-gray-800')
          } else {
            // Restore based on scroll position and header mode
            const header = document.querySelector('[data-header]') as HTMLElement | null
            const isAlt = header?.dataset.headerAlt === 'true'
            if (!isAlt && window.scrollY <= 50) {
              s.classList.remove('bg-gray-800')
              s.classList.add('bg-white')
            }
          }
        })
      })
      // Close on link click
      mobileMenu.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
          body.classList.remove('nav-open')
          // Restore hamburger bar colors
          hamburgerBarsAll.forEach(s => {
            const header = document.querySelector('[data-header]') as HTMLElement | null
            const isAlt = header?.dataset.headerAlt === 'true'
            if (!isAlt && window.scrollY <= 50) {
              s.classList.remove('bg-gray-800')
              s.classList.add('bg-white')
            }
          })
        })
      })
    }

    // Simple counter animation for metrics
    const counters = document.querySelectorAll('[data-counter]')
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const el = entry.target as HTMLElement
          const end = el.dataset.counter || '0'
          el.textContent = end
          observer.unobserve(el)
        }
      })
    }, { threshold: 0.5 })
    counters.forEach(c => observer.observe(c))
  </script>
</body>
</html>
