---
interface Props {
  alt?: boolean
}
const { alt = false } = Astro.props
const currentPath = Astro.url.pathname
const base = import.meta.env.BASE_URL

const navLinks = [
  { label: 'About', href: `${base}about/` },
  { label: 'Team', href: `${base}team/` },
  { label: 'Portfolio', href: `${base}portfolio/` },
  { label: 'Newsroom', href: `${base}newsroom/` },
  { label: 'Contact', href: `${base}contact/` },
]

const isActive = (href: string) => currentPath === href || currentPath.startsWith(href.replace(/\/$/, '') + '/')
---

<header
  data-header
  data-header-alt={alt ? 'true' : 'false'}
  class:list={[
    'fixed top-0 left-0 right-0 z-50 transition-all duration-300',
    alt ? 'bg-white/95 backdrop-blur-md shadow-sm' : 'bg-transparent'
  ]}
>
  <div class="max-w-[1440px] mx-auto px-6 lg:px-12 flex items-center justify-between h-20 lg:h-24">
    <!-- Logo: white for hero overlay, black for inner pages -->
    <a href={base} class="relative z-10 flex-shrink-0">
      <img
        src={alt ? `${base}assets/images/logos/kalterra-black.png` : `${base}assets/images/logos/kalterra-white.png`}
        alt="Kalterra"
        class="h-10 lg:h-14 w-auto"
        data-logo
        data-logo-black={`${base}assets/images/logos/kalterra-black.png`}
        data-logo-white={`${base}assets/images/logos/kalterra-white.png`}
      />
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden lg:flex items-center gap-10">
      {navLinks.map(link => (
        <a
          href={link.href}
          class:list={[
            'text-sm font-medium uppercase tracking-widest hover:text-gold',
            isActive(link.href) ? 'text-gold' : (alt ? 'text-gray-800' : 'text-white')
          ]}
        >
          {link.label}
        </a>
      ))}
      <a
        href="https://investors.appfolioim.com/kalterracapital/investor/login"
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm font-medium uppercase tracking-widest text-gold hover:text-gold-light"
      >
        Investor Login
      </a>
    </nav>

    <!-- Mobile Menu Toggle -->
    <button
      data-menu-toggle
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class:list={[
        'lg:hidden relative z-50 flex flex-col items-center justify-center w-10 h-10 gap-1.5',
      ]}
    >
      <span class:list={['block w-7 h-0.5 transition-transform', alt ? 'bg-gray-800' : 'bg-white']} aria-hidden="true"></span>
      <span class:list={['block w-7 h-0.5 transition-transform', alt ? 'bg-gray-800' : 'bg-white']} aria-hidden="true"></span>
      <span class:list={['block w-5 h-0.5 transition-transform ml-auto', alt ? 'bg-gray-800' : 'bg-white']} aria-hidden="true"></span>
    </button>
  </div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    data-mobile-menu
    role="dialog"
    aria-label="Navigation menu"
    class="mobile-menu fixed inset-0 bg-white z-40 flex flex-col items-center justify-center lg:hidden"
  >
    <nav class="flex flex-col items-center gap-8">
      {navLinks.map(link => (
        <a
          href={link.href}
          class:list={[
            'text-2xl font-medium uppercase tracking-widest hover:text-gold',
            isActive(link.href) ? 'text-gold' : 'text-gray-900'
          ]}
        >
          {link.label}
        </a>
      ))}
      <a
        href="https://investors.appfolioim.com/kalterracapital/investor/login"
        target="_blank"
        rel="noopener noreferrer"
        class="text-2xl font-medium uppercase tracking-widest text-gold hover:text-gold-light"
      >
        Investor Login
      </a>
    </nav>
  </div>
</header>
