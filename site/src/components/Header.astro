---
interface Props {
  alt?: boolean
}
const { alt = false } = Astro.props
const currentPath = Astro.url.pathname
const base = import.meta.env.BASE_URL

const navLinks = [
  { label: 'About', href: `${base}about/` },
  { label: 'Team', href: `${base}team/` },
  { label: 'Portfolio', href: `${base}portfolio/` },
  { label: 'Newsroom', href: `${base}newsroom/` },
  { label: 'Contact', href: `${base}contact/` },
]

const isActive = (href: string) => currentPath === href || currentPath.startsWith(href.replace(/\/$/, '') + '/')
---

<header
  data-header
  class:list={[
    'fixed top-0 left-0 right-0 z-50 transition-all duration-300',
    alt ? 'bg-black/90 backdrop-blur-md' : 'bg-transparent'
  ]}
>
  <div class="max-w-[1440px] mx-auto px-6 lg:px-12 flex items-center justify-between h-20 lg:h-24">
    <!-- Logo -->
    <a href={base} class="relative z-10 flex-shrink-0">
      <img
        src={`${base}assets/images/logos/kalterra-white.png`}
        alt="Kalterra"
        class="h-8 lg:h-10 w-auto"
      />
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden lg:flex items-center gap-10">
      {navLinks.map(link => (
        <a
          href={link.href}
          class:list={[
            'text-sm font-medium uppercase tracking-widest hover:text-gold',
            isActive(link.href) ? 'text-gold' : 'text-white'
          ]}
        >
          {link.label}
        </a>
      ))}
      <a
        href="https://investors.appfolioim.com/kalterracapital/investor/login"
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm font-medium uppercase tracking-widest text-gold hover:text-gold-light"
      >
        Investor Login
      </a>
    </nav>

    <!-- Mobile Menu Toggle -->
    <button
      data-menu-toggle
      aria-label="Toggle menu"
      aria-expanded="false"
      class="lg:hidden relative z-10 flex flex-col items-center justify-center w-10 h-10 gap-1.5"
    >
      <span class="block w-7 h-0.5 bg-white transition-all"></span>
      <span class="block w-7 h-0.5 bg-white transition-all"></span>
      <span class="block w-5 h-0.5 bg-white transition-all ml-auto"></span>
    </button>
  </div>

  <!-- Mobile Menu -->
  <div
    data-mobile-menu
    class="mobile-menu fixed inset-0 bg-black/98 z-40 flex flex-col items-center justify-center lg:hidden"
  >
    <nav class="flex flex-col items-center gap-8">
      {navLinks.map(link => (
        <a
          href={link.href}
          class:list={[
            'text-2xl font-medium uppercase tracking-widest hover:text-gold',
            isActive(link.href) ? 'text-gold' : 'text-white'
          ]}
        >
          {link.label}
        </a>
      ))}
      <a
        href="https://investors.appfolioim.com/kalterracapital/investor/login"
        target="_blank"
        rel="noopener noreferrer"
        class="text-2xl font-medium uppercase tracking-widest text-gold hover:text-gold-light"
      >
        Investor Login
      </a>
    </nav>
  </div>
</header>
