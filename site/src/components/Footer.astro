---
const currentYear = new Date().getFullYear()
const base = import.meta.env.BASE_URL
---

<footer class="bg-gray-900">
  <!-- Main Footer -->
  <div class="max-w-[1440px] mx-auto px-6 lg:px-12 py-16 lg:py-20">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-8">
      <!-- Brand -->
      <div class="lg:col-span-1">
        <a href={base}>
          <img
            src={`${base}assets/images/logos/kalterra-white.png`}
            alt="Kalterra"
            class="h-10 lg:h-14 w-auto mb-6"
            data-logo
          />
        </a>
        <p class="text-gray-400 text-base leading-relaxed">
          Texas Multifamily Acquisitions.<br />
          Local Execution. Durable Returns.
        </p>
      </div>

      <!-- Navigation -->
      <div>
        <h5 class="text-sm font-semibold uppercase tracking-widest text-white mb-6">Navigation</h5>
        <nav class="flex flex-col gap-3">
          <a href={`${base}about/`} class="text-gray-400 hover:text-white text-base">About</a>
          <a href={`${base}team/`} class="text-gray-400 hover:text-white text-base">Team</a>
          <a href={`${base}portfolio/`} class="text-gray-400 hover:text-white text-base">Portfolio</a>
          <a href={`${base}newsroom/`} class="text-gray-400 hover:text-white text-base">Newsroom</a>
          <a href={`${base}contact/`} class="text-gray-400 hover:text-white text-base">Contact</a>
        </nav>
      </div>

      <!-- Contact -->
      <div>
        <h5 class="text-sm font-semibold uppercase tracking-widest text-white mb-6">Contact</h5>
        <div class="flex flex-col gap-3 text-gray-400 text-base">
          <p>1845 Woodall Rodgers Fwy<br />Ste 1160<br />Dallas, TX 75201</p>
          <p>By appointment only<br />Mon&ndash;Fri</p>
          <a href="mailto:info@kalterra.com" class="hover:text-white">info@kalterra.com</a>
        </div>
      </div>

      <!-- Connect -->
      <div>
        <h5 class="text-sm font-semibold uppercase tracking-widest text-white mb-6">Connect</h5>
        <div class="flex flex-col gap-3">
          <a
            href="https://www.linkedin.com/company/kalterra-capital-partners/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-400 hover:text-white text-base inline-flex items-center gap-2"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            LinkedIn
          </a>
          <a
            href="https://investors.appfolioim.com/kalterracapital/investor/login"
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-400 hover:text-white text-base"
          >
            Investor Login
          </a>
        </div>

        <!-- Fair Housing & Accessibility -->
        <div class="mt-8 flex items-center gap-4">
          <svg class="h-10 w-auto text-gray-400" viewBox="0 0 42 44" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Equal Housing Opportunity">
            <rect x="1" y="1" width="40" height="42" rx="1" stroke="currentColor" stroke-width="1.5" fill="none"/>
            <path d="M21 4 L38 18 H4 Z" stroke="currentColor" stroke-width="1.5" fill="none"/>
            <rect x="15" y="20" width="12" height="14" stroke="currentColor" stroke-width="1.2" fill="none"/>
            <line x1="21" y1="20" x2="21" y2="34" stroke="currentColor" stroke-width="1"/>
            <line x1="15" y1="27" x2="27" y2="27" stroke="currentColor" stroke-width="1"/>
            <text x="21" y="41" font-size="4" text-anchor="middle" fill="currentColor" font-family="Inter, Arial, sans-serif" font-weight="600" letter-spacing="0.5">EQUAL HOUSING</text>
          </svg>
          <svg class="h-10 w-auto text-gray-400" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Accessibility">
            <circle cx="20" cy="20" r="18.5" stroke="currentColor" stroke-width="1.5"/>
            <circle cx="20" cy="11" r="3" fill="currentColor"/>
            <path d="M12 17.5 L20 19.5 L28 17.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M20 19.5 L20 25" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            <path d="M20 25 L15 33" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            <path d="M20 25 L25 33" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="border-t border-gray-800">
    <div class="max-w-[1440px] mx-auto px-6 lg:px-12 py-6 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-gray-500 text-sm">
        &copy; {currentYear} Kalterra Capital Partners. All rights reserved.
      </p>
      <div class="flex items-center gap-6 text-sm text-gray-500">
        <a href={`${base}disclaimer/`} class="hover:text-white">Disclaimer</a>
        <a href={`${base}privacy-policy/`} class="hover:text-white">Privacy Policy</a>
      </div>
    </div>
  </div>
</footer>
